{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "Animated shader skies that can react to your music. Configure with /dynamicskies.",
    "authors": [
        "ootruffle"
    ],
    "license": "MIT",
    "environment": "client",
    "entrypoints": {
        "init": [
            "com.ootruffle.dynamicskies.DynamicSkiesEntrypoint"
        ]
    },
    "mixins": [
        "mixins.${mod_id}.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "1.8.9",
        "osl": ">=${osl_version}",
        "oneconfig": ">=${oneconfig_version}"
    },
    "contact": {
        "homepage": "https://github.com/ooTruffle/Dynamic-Skys",
        "sources": "https://github.com/ooTruffle/Dynamic-Skys",
        "issues": "https://github.com/ooTruffle/Dynamic-Skys/issues"
    },
    "custom": {
        "modupdatechecker": {
            "github": "ooTruffle/Dynamic-Skys"
        }
    }
}
